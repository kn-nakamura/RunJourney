        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo generar la imagen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Échec du rendu de l'image" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Impossibile generare l'immagine" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "画像の生成に失敗しました" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이미지 생성에 실패했어요" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Falha ao gerar a imagem" } },
