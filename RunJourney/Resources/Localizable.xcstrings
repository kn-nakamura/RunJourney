    "Free is limited to %lld races and %lld total results." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die kostenlose Version ist auf %lld Rennen und insgesamt %lld Ergebnisse begrenzt." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La versión gratuita está limitada a %lld carreras y %lld resultados en total." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La version gratuite est limitée à %lld courses et %lld résultats au total." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La versione gratuita è limitata a %lld gare e %lld risultati totali." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "無料プランでは最大 %lld 件のレースと累計 %lld 件の結果まで利用できます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "무료 플랜은 최대 %lld 개의 레이스와 누적 %lld 개의 결과까지만 사용할 수 있어요." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A versão gratuita está limitada a %lld corridas e %lld resultados no total." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "免费版最多支持 %lld 场赛事和共计 %lld 项成绩。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "免費版最多支援 %lld 場賽事和共計 %lld 筆成績。" } }
      }
    },
    "Generating…" : {
      "extractionState" : "manual",
