    "Adds 8 demo races across Japan. Skips duplicates." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Fügt 8 Demo-Rennen in ganz Japan hinzu. Duplikate werden übersprungen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Añade 8 carreras de demostración por todo Japón. Omite duplicados." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ajoute 8 courses de démonstration à travers le Japon. Les doublons sont ignorés." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Aggiunge 8 gare dimostrative in tutto il Giappone. I duplicati vengono ignorati." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "日本各地のデモレース 8 件を追加します。重複はスキップします。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "일본 각지의 데모 레이스 8개를 추가해요. 중복은 건너뜁니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Adiciona 8 corridas de demonstração pelo Japão. Duplicatas são ignoradas." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加 8 场日本各地的示例赛事，重复项会被跳过。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "新增 8 場日本各地的示範賽事，重複項目會被略過。" } }
      }
    },
