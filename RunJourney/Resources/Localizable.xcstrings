    "Attach PDFs to your races and results." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Hänge PDFs an deine Rennen und Ergebnisse an." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Adjunta archivos PDF a tus carreras y resultados." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Attachez des PDF à vos courses et résultats." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Allega PDF alle tue gare e ai tuoi risultati." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "レースや結果に PDF を添付できます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "레이스나 결과에 PDF를 첨부할 수 있어요." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Anexe PDFs às suas corridas e resultados." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可在赛事与成绩中添加 PDF 附件。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可在賽事與成績中新增 PDF 附件。" } }
      }
    },
    "Checking…" : {
