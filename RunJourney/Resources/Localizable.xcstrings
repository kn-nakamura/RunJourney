        "es" : { "stringUnit" : { "state" : "translated", "value" : "Comprobando…" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vérification…" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Controllo in corso…" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "確認中…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "확인 중…" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Verificando…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检查中…" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "檢查中…" } }
      }
    },
    "Choose what to delete. This cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wähle aus, was gelöscht werden soll. Kann nicht rückgängig gemacht werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige qué eliminar. No se puede deshacer." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez ce que vous voulez supprimer. Action irréversible." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Scegli cosa eliminare. Operazione irreversibile." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "削除する対象を選んでください。元に戻せません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "삭제할 항목을 선택해 주세요. 되돌릴 수 없어요." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escolha o que deseja apagar. Não pode ser desfeito." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请选择要删除的内容。无法撤销。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請選擇要刪除的內容。無法復原。" } }
      }
    },
    "Dark suits city neon at night. Light brings natural daylight tones; the map switches with the theme. Choose System to follow your iOS appearance." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Dark passt zu nächtlichem Stadt-Neon, Light bringt natürliche Tageslichttöne, und die Karte folgt dem Thema. Wähle System, um dem iOS-Erscheinungsbild zu folgen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Dark se adapta al neón nocturno; Light aporta tonos de luz natural y el mapa cambia con el tema. Elige System para seguir la apariencia de iOS." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le mode Dark va avec les néons urbains la nuit ; Light apporte des tons de lumière naturelle et la carte suit le thème. Choisissez System pour suivre l'apparence d'iOS." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Dark si adatta al neon notturno della città; Light porta tonalità di luce naturale e la mappa segue il tema. Scegli System per seguire l'aspetto di iOS." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Dark は夜のシティネオンに、Light は昼の自然光に合います。マップもテーマに連動します。System を選ぶと iOS の外観設定に追従します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Dark는 야간 네온 분위기에, Light는 자연광 톤에 어울리며 지도도 테마에 따라 바뀌어요. System을 선택하면 iOS 외관 설정을 따릅니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Dark combina com o neon noturno da cidade; Light traz tons de luz natural e o mapa muda junto com o tema. Escolha System para acompanhar a aparência do iOS." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Dark 适合夜晚的霓虹氛围；Light 呈现自然日光色调，地图也会随主题切换。选择 System 即跟随 iOS 外观设置。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Dark 適合夜晚的霓虹氛圍；Light 呈現自然日光色調，地圖會隨主題切換。選擇 System 將跟隨 iOS 外觀設定。" } }
      }
    },
    "Deletes all registered results (times, routes). Race entries are kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Löscht alle registrierten Ergebnisse (Zeiten, Strecken). Renn-Einträge bleiben erhalten." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elimina todos los resultados registrados (tiempos, rutas). Las carreras se conservan." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprime tous les résultats enregistrés (temps, parcours). Les courses sont conservées." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Elimina tutti i risultati registrati (tempi, percorsi). Le gare vengono conservate." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "登録済みの結果（タイム・ルート）をすべて削除します。レース情報は保持されます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "등록된 모든 결과(기록·경로)를 삭제해요. 레이스 항목은 유지됩니다." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Apaga todos os resultados registrados (tempos, rotas). As corridas são mantidas." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除所有已记录的成绩（用时、路线）。赛事条目保留。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "刪除所有已記錄的成績（用時、路線）。賽事條目會保留。" } }
      }
    },
    "Deletes all saved pace plans." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Löscht alle gespeicherten Pace-Pläne." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elimina todos los planes de ritmo guardados." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprime tous les plans d'allure enregistrés." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Elimina tutti i piani di ritmo salvati." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "保存済みのペースプランをすべて削除します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저장된 페이스 플랜을 모두 삭제해요." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Apaga todos os planos de ritmo salvos." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除所有已保存的配速方案。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "刪除所有已儲存的配速計畫。" } }
      }
    },
    "Deletes everything (races, results, pace plans). Cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Löscht alles (Rennen, Ergebnisse, Pace-Pläne). Kann nicht rückgängig gemacht werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elimina todo (carreras, resultados, planes de ritmo). No se puede deshacer." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprime tout (courses, résultats, plans d'allure). Action irréversible." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Elimina tutto (gare, risultati, piani di ritmo). Operazione irreversibile." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "すべて（レース・結果・ペースプラン）を削除します。元に戻せません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "모든 데이터(레이스·결과·페이스 플랜)를 삭제해요. 되돌릴 수 없어요." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Apaga tudo (corridas, resultados, planos de ritmo). Não pode ser desfeito." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除所有内容（赛事、成绩、配速方案）。无法撤销。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "刪除所有內容（賽事、成績、配速計畫）。無法復原。" } }
      }
    },
    "Deletes race entries and all linked results." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Löscht Renn-Einträge und alle verknüpften Ergebnisse." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elimina las carreras y todos sus resultados asociados." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprime les courses et tous leurs résultats associés." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Elimina le gare e tutti i risultati collegati." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "レース情報と紐づく結果をすべて削除します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "레이스 항목과 연결된 모든 결과를 삭제해요." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Apaga as corridas e todos os resultados vinculados." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除赛事条目及其全部关联成绩。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "刪除賽事條目及其所有關聯成績。" } }
      }
    },
    "Failed to render image" : {
